<Window x:Class="PCL2Unlock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL2 下载解锁" Height="720" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="app.ico"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                <TextBlock Text="PCL" Foreground="White" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PCL2 下载解锁" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="解除原版 PCL 2.99.x 在中国大陆地区的下载 / 安装限制（IL 补丁，可随时还原）"
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 目标文件 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="目标文件" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Height="36">
                        <TextBox x:Name="TargetBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 Margin="12,0" FontSize="14" TextChanged="OnTargetChanged" />
                    </Border>
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnBrowse" />
                </Grid>
                <TextBlock Text="提示：可以直接把 Plain Craft Launcher 2.exe 拖进这个窗口" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- 状态 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" Grid.Column="0" CornerRadius="8" Padding="14,10" VerticalAlignment="Center" Background="#EEF1F6">
                    <StackPanel>
                        <TextBlock x:Name="BadgeText" Text="检测中…" FontSize="18" FontWeight="Bold" Foreground="#4B5563" />
                        <TextBlock x:Name="BadgeSub" Text="" FontSize="12" Foreground="#6B7280" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Grid Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="PCL 版本" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="VersionText" Text="-" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="文件大小" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="SizeText" Text="-" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                        <TextBlock Text="原始备份" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="BackupText" Text="-" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                        <TextBlock Text="SHA-256" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="HashText" Text="-" Style="{StaticResource FieldValue}" FontFamily="Consolas" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 操作 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenFolderBtn" Grid.Column="0" Content="打开所在目录" Style="{StaticResource SecondaryButton}" Click="OnOpenFolder" />
            <Button x:Name="RefreshBtn" Grid.Column="2" Content="重新检测" Style="{StaticResource GhostButton}" Click="OnRefresh" Margin="0,0,4,0" />
            <Button x:Name="RevertBtn" Grid.Column="3" Content="还原备份" Style="{StaticResource GhostButton}" Click="OnRevert" Margin="0,0,4,0" />
            <Button x:Name="ApplyBtn" Grid.Column="4" Content="应用补丁" Style="{StaticResource PrimaryButton}" Click="OnApply" />
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="日志" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <Button Content="清空" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Height="26" Padding="10,0"
                            FontSize="12" Click="OnClearLog" />
                </Grid>
                <ScrollViewer x:Name="LogScroll" Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12.5" Foreground="#334155"
                               TextWrapping="Wrap" LineHeight="19" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 页脚 -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}">
                <Run Text="仅供学习研究，请自行承担风险；请勿用于商业用途。" />
                <Run Text="  限制来源 " /><Hyperlink NavigateUri="https://github.com/Meloong-Git/PCL" RequestNavigate="OnNavigate"><Run Text="Meloong-Git/PCL 2.99.x" /></Hyperlink>
                <Run Text=" · " /><Hyperlink NavigateUri="https://github.com/ailixiyaX/PCL2Unlock" RequestNavigate="OnNavigate"><Run Text="GitHub 项目主页" /></Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
